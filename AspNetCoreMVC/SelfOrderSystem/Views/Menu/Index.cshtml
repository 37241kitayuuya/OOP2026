@model SelfOrderSystem.ViewModels.MenuViewModel

@{
    ViewData["Title"] = "お食事メニュー";
}

<div class="so-menu-page">

    @* メニュー画面のヘッダー *@
    <header class="so-menu-header">
        <span>お食事メニュー</span>
        <span aria-hidden="true">🛒</span>
    </header>

    @* エラーメッセージ *@
    @if (TempData["Error"] is string error) {
        <div class="alert alert-danger m-3">
            @error
        </div>
    }

    @* カテゴリを選択 *@
    <nav class="so-menu-categories">
        <a asp-action="Index"
           class="@(Model.SelectedCategoryId == null ? "active" : "")">
            すべて
        </a>

        @foreach (var category in Model.Categories) {
            <a asp-action="Index"
               asp-route-categoryId="@category.Id"
               class="@(Model.SelectedCategoryId == category.Id ? "active" : "")">
                @category.Name
            </a>
        }
    </nav>

    @* 商品一覧 *@
    <div class="so-menu-products">

        @foreach (var product in Model.Products) {
            <article class="so-menu-product">

                @* 商品写真 *@
                @if (!string.IsNullOrWhiteSpace(product.ImagePath)) {
                    <img src="@product.ImagePath"
                         alt="@product.Name"
                         class="so-menu-photo" />
                } else {
                    <div class="so-menu-photo so-menu-photo-empty">
                        写真なし
                    </div>
                }

                @* 商品名・説明・価格 *@
                <div class="so-menu-info">
                    <h2>@product.Name</h2>

                    <p>@product.Description</p>

                    <strong>
                        ¥@product.Price.ToString("N0")
                    </strong>
                </div>

                @* カート追加ボタン *@
                <form asp-controller="Cart"
                      asp-action="Add"
                      method="post">

                    <input type="hidden"
                           name="productId"
                           value="@product.Id" />

                    @if (product.IsSoldOut) {
                        <button type="button"
                                class="so-menu-add"
                                disabled>
                            売り切れ
                        </button>
                    } else {
                        <button type="submit"
                                class="so-menu-add">
                            追加 ＋
                        </button>
                    }
                </form>

            </article>
        }
    </div>

    @* カート概要 *@
    <section class="so-menu-cart">

        <div class="so-menu-cart-summary">
            <div>
                <strong>
                    カート @Model.CartItemCount 点
                </strong>
                <small>現在の合計</small>
            </div>

            <strong class="so-menu-cart-price">
                ¥@Model.CartTotal.ToString("N0")
            </strong>
        </div>

        <a asp-controller="Cart"
           asp-action="Index"
           class="so-menu-cart-button">
            カートを確認する
        </a>

    </section>

</div>
