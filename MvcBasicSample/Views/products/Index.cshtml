@model List<MvcBasicSample.Models.Product>;

@{
    ViewData["Title"] = "商品一覧";
}

<h1>商品情報</h1>
@*件数が０件なら説明のみ表示*@
@if(Model.Count == 0)
{
    <p>商品はありません</p>
}else{
<p>@Model.Count 件の商品があります</p>
    @foreach(var product in Model)
    {
        <p>@product.name@product.price　円</p>
    }
}
