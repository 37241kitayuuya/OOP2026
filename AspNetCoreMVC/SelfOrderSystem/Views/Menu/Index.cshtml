@model SelfOrderSystem.ViewModels.MenuViewModel

@{
    ViewData["Title"] = "メニュー";
}

<div class="menu-heading">
    <div>
        <p class="menu-subtitle">WELCOME</p>
        <h1>メニュー</h1>
        <p class="menu-description">お好きな商品をお選びください</p>
    </div>
</div>

<div class="d-flex gap-2 overflow-auto pb-3 category-list">
    <a class="btn category-btn @(Model.SelectedCategoryId == null ? "active" : "")"
       asp-action="Index">すべて</a>

    @foreach (var category in Model.Categories) {
        <a class="btn category-btn @(Model.SelectedCategoryId == category.Id ? "active" : "")"
           asp-action="Index"
           asp-route-categoryId="@category.Id">
            @category.Name
        </a>
    }
</div>

@if (TempData["Error"] is string errorMessage) {
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-4">

    @* 左側商品一覧 *@
    <div class="col-12 col-lg-9">
        <div class="row g-3">

            @foreach (var product in Model.Products) {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 product-card">

                        @if (!string.IsNullOrWhiteSpace(product.ImagePath)) {
                            <img src="@Url.Content(product.ImagePath)"
                                 class="so-product-photo"
                                 alt="@product.Name"
                                 loading="lazy" />
                        } else {
                            <div class="so-product-photo so-product-photo--empty">
                                写真準備中
                            </div>
                        }

                        <div class="card-body d-flex flex-column">

                            <h2 class="product-name">@product.Name</h2>

                            <p class="product-description flex-grow-1">
                                @product.Description
                            </p>

                            <p class="product-price">
                                @product.Price.ToString("N0") <small>円</small>
                            </p>

                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@product.Id" />

                                @if (product.IsSoldOut) {
                                    <button class="btn btn-secondary w-100 add-button" disabled>
                                        売り切れ
                                    </button>
                                } else {
                                    <button class="btn btn-primary w-100 add-button" type="submit">
                                        ＋ カートに追加
                                    </button>
                                }
                            </form>

                        </div>
                    </div>
                </div>
            }

        </div>
    </div>

    @* 右側カート概要 *@
    <div class="col-12 col-lg-3">
        <aside class="card so-cart-sidebar">
            <div class="card-body">

                <div class="cart-heading">
                    <span>🛒</span>
                    <h2>カート</h2>
                </div>

                <p class="cart-count">@Model.CartItemCount 点の商品</p>

                <div class="cart-total">
                    <span>合計金額</span>
                    <strong>@Model.CartTotal.ToString("N0")<small> 円</small></strong>
                </div>

                <a asp-controller="Cart"
                   asp-action="Index"
                   class="btn btn-primary w-100 cart-button">
                    カートを確認する →
                </a>

            </div>
        </aside>
    </div>

</div>

@* スマホ用カートバー *@
@if (Model.CartItemCount > 0) {
    <div class="mobile-cart-bar">

        <div class="mobile-cart-info">
            <span class="mobile-cart-count">
                @Model.CartItemCount 点
            </span>

            <span class="mobile-cart-total">
                @Model.CartTotal.ToString("N0") 円
            </span>
        </div>

        <a class="btn mobile-cart-button"
           asp-controller="Cart"
           asp-action="Index">
            注文内容を確認 →
        </a>

    </div>
}
